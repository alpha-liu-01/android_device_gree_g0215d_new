# Root symlink to /vendor/bt_firmware (BOARD_ROOT_EXTRA_SYMLINKS); libbt-vendor
# reads the Rome firmware through it.
/bt_firmware(/.*)?    u:object_r:bt_firmware_file:s0
# Root symlink to the modem firmware partition (BOARD_ROOT_EXTRA_SYMLINKS).
/firmware    u:object_r:firmware_file:s0
# Root symlink to /mnt/vendor/persist, the path the modem daemons use.
/persist    u:object_r:persist_file:s0

<?xml version="1.0" encoding="utf-8"?>
<!--
    1440x2560 phone with physical navigation keys.
    config_showNavigationBar stays off. Density is 640, set as ro.sf.lcd_density.
-->
<resources>
    <bool name="config_showNavigationBar">false</bool>

    <!-- The kernel reports the wired headset through its "Headset Jack" input
         switches; there is no /sys/class/switch/h2w node. -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Sensor 0, fingerprint, BIOMETRIC_STRONG. An empty array leaves the
         sensor at strength 0, so lock-screen success skips addAuthToken. -->
    <string-array name="config_biometric_sensors" translatable="false">
        <item>0:2:15</item>
    </string-array>
</resources>

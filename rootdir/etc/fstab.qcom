# Android fstab file.
#<src>                                  <mnt_point>              <type>  <mnt_flags and options>                            <fs_mgr_flags>
/dev/block/by-name/userdata  /data                    ext4    noatime,nosuid,nodev,barrier=1,noauto_da_alloc    wait,encryptable=footer
/dev/block/by-name/cache     /cache                   ext4    noatime,nosuid,nodev,barrier=1                     wait,nofail
/dev/block/by-name/dsp       /vendor/dsp              ext4    ro,nosuid,nodev,barrier=1                          wait,nofail
/dev/block/by-name/modem     /vendor/firmware_mnt     vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0  wait,nofail
/dev/block/by-name/bluetooth /vendor/bt_firmware      vfat    ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0  wait,nofail
/dev/block/by-name/persist   /mnt/vendor/persist      ext4    noatime,nosuid,nodev,barrier=1                     wait,nofail
/dev/block/by-name/misc      /misc                    emmc    defaults                                           defaults
